{
	"name": "phpgt/deploy",
	"description": "Deployment tools for PHP projects.",
	"license": "MIT",
	"require": {
		"php": ">=8.3",
		"phpgt/cli": "^1.4",
		"phpgt/config": "^1.3",
		"guzzlehttp/guzzle": "^7.9"
	},
	"require-dev": {
		"phpunit/phpunit": "^12.5",
		"phpstan/phpstan": "^2.2",
		"phpmd/phpmd": "^3.0",
		"squizlabs/php_codesniffer": "^4.0"
	},
	"autoload": {
		"psr-4": {
			"GT\\Deploy\\": "./src",
			"Gt\\Deploy\\": "./src"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"GT\\Deploy\\Test\\": "./test/phpunit"
		}
	},
	"config": {
		"platform": {
			"php": "8.3.0"
		}
	},
	"bin": [
		"bin/deploy"
	],
	"scripts": {
		"phpunit": "vendor/bin/phpunit --configuration phpunit.xml",
		"phpcs": "vendor/bin/phpcs src --standard=phpcs.xml",
		"phpmd": "vendor/bin/phpmd src/ text phpmd.xml",
		"phpstan": "vendor/bin/phpstan analyse --level 6 src --memory-limit 256M",
		"test": [
			"@phpunit",
			"@phpcs",
			"@phpmd",
			"@phpstan",
			"@test-server"
		],
		"test-server": [
			"@php vendor/bin/phpunit --configuration server/phpunit.xml --do-not-cache-result",
			"@php vendor/bin/phpcs server/api server/class --standard=phpcs.xml",
			"@php vendor/bin/phpmd server/api,server/class text phpmd.xml",
			"@php vendor/bin/phpstan analyse --level 6 server/class --autoload-file server/vendor/autoload.php --memory-limit 256M"
		]
	},
	"funding": [
		{
			"type": "github",
			"url": "https://github.com/sponsors/PhpGt"
		}
	]
}
